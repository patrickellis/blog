---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, RETENTION_DAYS, RIOT_APIS } from '../consts';

/* ------------------------------------------------------------------
   Sample report data — illustrative only, not a real player.
   Numbers are internally consistent (40 games, 4.33 avg, 21 top-4s).
   ------------------------------------------------------------------ */
const sample = {
	games: 40,
	avgPlacement: 4.33,
	top4Rate: 53,
	avgLevel: 7.6,
	rank: 'Gold II',
};

// Average placement per block of 5 games, oldest → newest.
const trend = [4.8, 4.8, 4.6, 4.4, 4.2, 4.0, 4.0, 3.8];

const chart = { w: 560, h: 220, padL: 40, padR: 16, padT: 16, padB: 34, min: 3.5, max: 5.0 };
const innerW = chart.w - chart.padL - chart.padR;
const innerH = chart.h - chart.padT - chart.padB;
const x = (i: number) => chart.padL + (i / (trend.length - 1)) * innerW;
// Lower placement is better, so lower values sit higher on the chart.
const y = (v: number) => chart.padT + ((v - chart.min) / (chart.max - chart.min)) * innerH;
const linePath = trend.map((v, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const areaPath = `${linePath} L${x(trend.length - 1).toFixed(1)},${chart.h - chart.padB} L${x(0).toFixed(1)},${chart.h - chart.padB} Z`;
const yTicks = [3.5, 4.0, 4.5, 5.0];

// Small hero sparkline.
const spark = { w: 220, h: 56 };
const sparkPath = trend
	.map((v, i) => {
		const sx = (i / (trend.length - 1)) * spark.w;
		const sy = 4 + ((v - chart.min) / (chart.max - chart.min)) * (spark.h - 8);
		return `${i === 0 ? 'M' : 'L'}${sx.toFixed(1)},${sy.toFixed(1)}`;
	})
	.join(' ');

const comps = [
	{ name: 'Fast 8 · 4-cost carry', games: 15, avg: 3.9, peers: 4.2 },
	{ name: '1-cost reroll', games: 11, avg: 4.9, peers: 4.3 },
	{ name: '3-cost reroll', games: 9, avg: 4.1, peers: 4.3 },
	{ name: 'Flex / other', games: 5, avg: 4.8, peers: 4.4 },
];

const levelTiming = [
	{ label: 'Reached level 8 before 4-5', games: 17, avg: 3.6 },
	{ label: 'Reached level 8 at 4-5 or later', games: 23, avg: 4.87 },
];

const analyses = [
	{
		title: 'Placement trends',
		body: 'How your average placement and top-4 rate change over time and from patch to patch, so you can tell real improvement from a lucky streak.',
		icon: '<path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
	},
	{
		title: 'Comp habits',
		body: 'The comps you play most, how you do on each compared with players at your rank, and whether you lean too heavily on just a few.',
		icon: '<path d="M12 2l8.66 5v10L12 22l-8.66-5V7z"/><path d="M12 22V12M20.66 7 12 12 3.34 7"/>',
	},
	{
		title: 'Level & econ timing',
		body: 'The level you finish at and the round you go out, set against your final placement, to spot habits like levelling too late or rolling down too early.',
		icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	},
	{
		title: 'Itemisation',
		body: 'How you build items on your main carries, and whether the builds you reach for most often actually work for you.',
		icon: '<path d="M14.5 4l5.5 5.5-9.5 9.5H5v-5.5z"/><path d="M12 6.5l5.5 5.5"/>',
	},
	{
		title: 'Unit star levels',
		body: 'How often your board is still under-upgraded when you’re knocked out, and which carries you tend to leave at 2-star too long.',
		icon: '<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/>',
	},
	{
		title: 'Focus points',
		body: 'Every report ends with two or three specific, evidence-backed points to keep in mind next session. You stay in charge of how you adjust.',
		icon: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
	},
];

const principles = [
	{
		title: 'Nothing runs in-game',
		body: 'No overlay, nothing running while you play, and no live or game-state advice. All analysis happens before or after your games.',
	},
	{
		title: 'No scouting',
		body: 'It doesn’t track or predict opponents, and never shows lobby or opponent stats.',
	},
	{
		title: 'No banned stats',
		body: 'No win rates for Legends or Legend-based augments. Augment stats aren’t included at launch either.',
	},
	{
		title: 'No unofficial ranks',
		body: 'It doesn’t calculate MMR or any alternative ranking. Your rank is the one Riot shows you.',
	},
	{
		title: 'No prescriptions',
		body: 'It never tells you what to play. It points out patterns and offers a few options, and you decide what to change.',
	},
];

const dataPoints = [
	{
		title: 'Your data only',
		body: 'You sign in with Riot Sign-On, so you only ever see your own match history. No looking up other players.',
	},
	{
		title: 'Anonymous comparisons',
		body: 'Rank-peer comparisons come from anonymised, aggregated data. Other players are never named or identifiable.',
	},
	{
		title: `${RETENTION_DAYS}-day retention`,
		body: `Match data is cached to stay within Riot’s rate limits and deleted after ${RETENTION_DAYS} days. You can ask for your data to be deleted at any time.`,
	},
	{
		title: 'Secure by default',
		body: 'Riot API keys stay on the server and never reach your browser. All traffic uses HTTPS.',
	},
];

const faqs = [
	{
		q: 'Is this allowed by Riot?',
		a: 'TFT Personal Tutor is designed around Riot’s Developer API policies for Teamfight Tactics. It only reviews games after they’ve finished, shows you only your own data, and leaves out the stats Riot doesn’t allow, such as Legend win rates and alternative ranks. It goes live once Riot approves its production API key.',
	},
	{
		q: 'Will it tell me what comp to play?',
		a: 'No. It shows how you perform on the comps you already play, compared with players at your rank, and points out patterns. When it suggests something to try, it gives you several options rather than one instruction.',
	},
	{
		q: 'Does it work during a game?',
		a: 'No. There’s no overlay or desktop client, and it doesn’t read live game state. It’s a website you open between sessions.',
	},
	{
		q: 'Which games does it look at?',
		a: 'Your recent ranked TFT games, fetched from Riot’s official TFT-MATCH-V1 API, plus your rank from TFT-LEAGUE-V1. Normal, Hyper Roll and Double Up games aren’t included at launch.',
	},
	{
		q: 'Why do I need to sign in with Riot?',
		a: 'Riot Sign-On confirms you own the account, so only you can see your coaching reports. We never see your Riot password.',
	},
	{
		q: 'How do I delete my data?',
		a: `Email ${CONTACT_EMAIL} from any address and include your Riot ID. We’ll delete your cached matches and reports and confirm when it’s done. Data is also deleted automatically after ${RETENTION_DAYS} days.`,
	},
];

const waitlistSubject = encodeURIComponent('TFT Personal Tutor waitlist');
---

<Layout>
	<!-- ============================== HERO ============================== -->
	<section class="hero" id="top">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="pill reveal"><span class="dot"></span>In development · Post-game only</span>
				<h1 class="reveal" style="--delay: 80ms">
					A TFT coach that studies <span class="gradient-text">your</span> games.
				</h1>
				<p class="lead reveal" style="--delay: 160ms">
					TFT Personal Tutor reviews your recent ranked Teamfight Tactics games and gives you a plain-language report: what you’re good at, the mistakes you keep repeating, and two or three things to focus on next session.
				</p>
				<div class="hero-ctas reveal" style="--delay: 240ms">
					<a href="#waitlist" class="btn btn-primary" id="hero-waitlist">
						Join the waitlist
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</a>
					<a href="#sample-report" class="btn btn-ghost" id="hero-sample">See a sample report</a>
				</div>
				<ul class="hero-trust reveal" style="--delay: 320ms">
					<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sign in with Riot</li>
					<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Your data only</li>
					<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Core analysis free</li>
				</ul>
			</div>

			<div class="hero-visual reveal" style="--delay: 200ms" aria-label="Preview of a sample coaching report">
				<div class="glow"></div>
				<div class="mini-report">
					<div class="mini-head">
						<span class="mini-title">Coaching report</span>
						<span class="badge">Sample</span>
					</div>
					<div class="mini-stat">
						<div>
							<span class="mini-num mono">{sample.avgPlacement.toFixed(2)}</span>
							<span class="mini-label">avg placement · last {sample.games} games</span>
						</div>
						<span class="delta good mono">▲ 1.0</span>
					</div>
					<svg class="spark" viewBox={`0 0 ${spark.w} ${spark.h}`} preserveAspectRatio="none" aria-hidden="true">
						<defs>
							<linearGradient id="spark-stroke" x1="0" x2="1">
								<stop offset="0" stop-color="var(--gold-400)" />
								<stop offset="1" stop-color="var(--teal-300)" />
							</linearGradient>
						</defs>
						<path d={sparkPath} fill="none" stroke="url(#spark-stroke)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
					</svg>
					<div class="mini-focus">
						<span class="mini-kicker">Focus point</span>
						<p>You place <strong>1.2 places better</strong> when you reach level 8 before round 4-5.</p>
					</div>
					<div class="mini-focus">
						<span class="mini-kicker">Pattern spotted</span>
						<p>Your bottom-4 games often hold a <strong>2-star 1-cost carry</strong> into stage 4.</p>
					</div>
				</div>
				<div class="floating-chip chip-a mono">Top-4 rate <strong>{sample.top4Rate}%</strong></div>
				<div class="floating-chip chip-b mono">Post-game only</div>
			</div>
		</div>
	</section>

	<!-- ========================== HOW IT WORKS ========================== -->
	<section class="section" id="how-it-works">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">How it works</span>
				<h2>From match history to a game plan in three steps</h2>
				<p>You don’t need to install anything or keep anything running. Check in between sessions and pick up where you left off.</p>
			</div>
			<ol class="steps grid grid-3">
				<li class="card reveal">
					<span class="step-num mono">01</span>
					<h3>Sign in with Riot</h3>
					<p>Use Riot Sign-On to confirm the account is yours. We never see your password, and you only ever see your own data.</p>
				</li>
				<li class="card reveal" style="--delay: 100ms">
					<span class="step-num mono">02</span>
					<h3>We review your ranked games</h3>
					<p>Your recent ranked matches and current rank are fetched from Riot’s official TFT APIs and analysed for patterns across games.</p>
				</li>
				<li class="card reveal" style="--delay: 200ms">
					<span class="step-num mono">03</span>
					<h3>Read your report</h3>
					<p>You get a plain-language summary of your strengths and recurring weaknesses, ending with two or three focus points for your next session.</p>
				</li>
			</ol>
		</div>
	</section>

	<!-- ========================= WHAT IT ANALYSES ======================= -->
	<section class="section" id="analysis">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">What it analyses</span>
				<h2>Patterns you can’t see one game at a time</h2>
				<p>One game is mostly noise. Over dozens of games, your habits start to show. The tutor looks at five areas that matter most for average placement.</p>
			</div>
			<div class="grid grid-3">
				{analyses.map((a, i) => (
					<article class="card reveal" style={`--delay: ${(i % 3) * 90}ms`}>
						<div class="icon-tile">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={a.icon} />
						</div>
						<h3>{a.title}</h3>
						<p>{a.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- ========================== SAMPLE REPORT ========================= -->
	<section class="section" id="sample-report">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">Sample report</span>
				<h2>What a report looks like</h2>
				<p>This example uses illustrative data for a made-up player, not real match history. It shows the format and tone of a real report.</p>
			</div>

			<div class="report reveal">
				<div class="report-banner">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
					Sample data for illustration only. It doesn’t represent a real player.
				</div>

				<header class="report-head">
					<div class="avatar" aria-hidden="true">SP</div>
					<div>
						<h3>SamplePlayer<span class="tag mono">#0000</span></h3>
						<p class="report-meta mono">Ranked · {sample.rank} · last {sample.games} games · current &amp; previous patch</p>
					</div>
				</header>

				<div class="stat-row">
					<div class="stat">
						<span class="stat-label">Average placement</span>
						<span class="stat-value mono">{sample.avgPlacement.toFixed(2)}</span>
						<span class="stat-sub good">Improved 1.0 since your first 5 games</span>
					</div>
					<div class="stat">
						<span class="stat-label">Top-4 rate</span>
						<span class="stat-value mono">{sample.top4Rate}%</span>
						<span class="stat-sub">21 of {sample.games} games</span>
					</div>
					<div class="stat">
						<span class="stat-label">Avg level at elimination</span>
						<span class="stat-value mono">{sample.avgLevel}</span>
						<span class="stat-sub">Rank peers: 7.9</span>
					</div>
					<div class="stat">
						<span class="stat-label">Games analysed</span>
						<span class="stat-value mono">{sample.games}</span>
						<span class="stat-sub">Ranked only</span>
					</div>
				</div>

				<div class="report-grid">
					<!-- Placement trend -->
					<section class="panel panel-wide">
						<div class="panel-head">
							<h4>Placement trend</h4>
							<span class="panel-hint">Average placement per 5 games · lower is better</span>
						</div>
						<svg class="trend-chart" viewBox={`0 0 ${chart.w} ${chart.h}`} role="img" aria-label="Average placement improving from 4.8 to 3.8 across 40 games">
							<defs>
								<linearGradient id="trend-fill" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0" stop-color="hsl(172 62% 56%)" stop-opacity="0.35" />
									<stop offset="1" stop-color="hsl(172 62% 56%)" stop-opacity="0" />
								</linearGradient>
								<linearGradient id="trend-stroke" x1="0" x2="1">
									<stop offset="0" stop-color="hsl(42 78% 66%)" />
									<stop offset="1" stop-color="hsl(172 70% 70%)" />
								</linearGradient>
							</defs>
							{yTicks.map((t) => (
								<g>
									<line x1={chart.padL} x2={chart.w - chart.padR} y1={y(t)} y2={y(t)} class="grid-line" />
									<text x={chart.padL - 10} y={y(t) + 4} text-anchor="end" class="axis-label">{t.toFixed(1)}</text>
								</g>
							))}
							<path d={areaPath} fill="url(#trend-fill)" />
							<path d={linePath} fill="none" stroke="url(#trend-stroke)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="trend-line" />
							{trend.map((v, i) => (
								<g>
									<circle cx={x(i)} cy={y(v)} r="4.5" class="trend-dot" />
									<text x={x(i)} y={chart.h - 10} text-anchor="middle" class="axis-label">{`${i * 5 + 1}–${i * 5 + 5}`}</text>
								</g>
							))}
						</svg>
					</section>

					<!-- Comp habits -->
					<section class="panel panel-wide">
						<div class="panel-head">
							<h4>Comp habits</h4>
							<span class="panel-hint">Compared with anonymised players at your rank</span>
						</div>
						<div class="table-wrap">
							<table class="comp-table">
								<thead>
									<tr><th scope="col">Comp style</th><th scope="col">Games</th><th scope="col">Your avg</th><th scope="col">Rank peers</th><th scope="col">Difference</th></tr>
								</thead>
								<tbody>
									{comps.map((c) => {
										const diff = +(c.peers - c.avg).toFixed(1);
										return (
											<tr>
												<td>
													{c.name}
													<span class="share-bar" style={`--w: ${(c.games / sample.games) * 100}%`} aria-hidden="true"></span>
												</td>
												<td class="mono">{c.games}</td>
												<td class="mono">{c.avg.toFixed(1)}</td>
												<td class="mono muted">{c.peers.toFixed(1)}</td>
												<td class={`mono ${diff >= 0 ? 'good' : 'bad'}`}>{diff >= 0 ? `▲ ${diff.toFixed(1)} better` : `▼ ${Math.abs(diff).toFixed(1)} worse`}</td>
											</tr>
										);
									})}
								</tbody>
							</table>
						</div>
						<p class="panel-note">65% of your games use just two comp styles. That isn’t a problem in itself, but your results on 1-cost reroll are well behind your rank peers.</p>
					</section>

					<!-- Level timing -->
					<section class="panel">
						<div class="panel-head">
							<h4>Level &amp; econ timing</h4>
						</div>
						<div class="bars">
							{levelTiming.map((l) => (
								<div class="bar-row">
									<div class="bar-label"><span>{l.label}</span><span class="mono muted">{l.games} games</span></div>
									<div class="bar-track">
										<span class="bar-fill" style={`--w: ${((8 - l.avg) / 7) * 100}%`}></span>
										<span class="bar-value mono">{l.avg.toFixed(1)}</span>
									</div>
								</div>
							))}
						</div>
						<p class="panel-note">Average placement. You finish <strong>1.2 places higher</strong> in games where you hit level 8 earlier.</p>
					</section>

					<!-- Items & star levels -->
					<section class="panel">
						<div class="panel-head">
							<h4>Itemisation &amp; star levels</h4>
						</div>
						<ul class="facts">
							<li><span class="fact-num mono">3.9</span><span>Average placement with your most-used carry build (18 games)</span></li>
							<li><span class="fact-num mono bad">4.8</span><span>Average placement with your second most-used build (9 games)</span></li>
							<li><span class="fact-num mono bad">9 / 19</span><span>Bottom-4 games where your main carry was still a 2-star 1-cost in stage 4</span></li>
						</ul>
					</section>

					<!-- Strengths / weaknesses -->
					<section class="panel">
						<div class="panel-head"><h4>Strengths</h4></div>
						<ul class="checklist good-list">
							<li>Your Fast 8 boards place 0.3 better than players at your rank.</li>
							<li>Your average placement has improved in six of your last seven 5-game blocks.</li>
							<li>Your main carry build converts well into top-4 finishes.</li>
						</ul>
					</section>
					<section class="panel">
						<div class="panel-head"><h4>Recurring weaknesses</h4></div>
						<ul class="checklist bad-list">
							<li>You reach level 8 late in 23 of 40 games.</li>
							<li>Your 1-cost reroll boards are often under-upgraded when you’re knocked out.</li>
							<li>Your second-choice item build underperforms by almost a full placement.</li>
						</ul>
					</section>
				</div>

				<!-- Focus points -->
				<section class="focus">
					<div class="panel-head">
						<h4>Focus points for your next session</h4>
						<span class="panel-hint">Options, not instructions. You decide what to change.</span>
					</div>
					<ol class="focus-list">
						<li>
							<p class="focus-claim">You place <strong>1.2 places better</strong> when you reach level 8 before round 4-5.</p>
							<p class="focus-options">Things you could try: hold a little more gold through stage 3, level on 4-1 when your board is stable, or simply note which games you hit 8 late and why.</p>
						</li>
						<li>
							<p class="focus-claim">Your bottom-4 games share a pattern of <strong>holding a 2-star 1-cost carry into stage 4</strong>.</p>
							<p class="focus-options">Things you could try: decide by stage 3 whether the reroll is really happening, roll down earlier while your units are less contested, or switch to a higher-cost carry when your copies aren’t showing up.</p>
						</li>
						<li>
							<p class="focus-claim">Your second most-used carry build places <strong>0.9 worse</strong> than your first.</p>
							<p class="focus-options">Things you could try: check which components push you into that build, or look back at the games where you used it and see whether the item or the board was the problem.</p>
						</li>
					</ol>
				</section>
			</div>
		</div>
	</section>

	<!-- ===================== PRINCIPLES / WHAT IT DOESN'T DO ===================== -->
	<section class="section" id="principles">
		<div class="container principles-wrap">
			<div class="principles-intro reveal">
				<span class="eyebrow">Fair-play commitments</span>
				<h2>What it will <span class="gradient-text">never</span> do</h2>
				<p>The tutor helps you learn from games you’ve already played. It doesn’t give you an edge during a match, and it’s built to stay within Riot’s policies for Teamfight Tactics.</p>
				<a href="/terms" class="btn btn-ghost" id="principles-terms">Read the terms</a>
			</div>
			<ul class="principles">
				{principles.map((p, i) => (
					<li class="principle reveal" style={`--delay: ${i * 70}ms`}>
						<span class="x-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
						</span>
						<div>
							<h3>{p.title}</h3>
							<p>{p.body}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ============================== DATA ============================== -->
	<section class="section" id="data">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">Your data</span>
				<h2>Your match history stays yours</h2>
				<p>We collect only what’s needed to coach you, keep it only as long as needed, and delete it whenever you ask.</p>
			</div>
			<div class="grid grid-2 data-grid">
